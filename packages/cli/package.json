{
  "name": "@adaptivekit/cli",
  "version": "1.0.0",
  "description": "CLI for AdaptiveKit. Injects data-ak-id attributes and generates the block manifest.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "adaptivekit": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omrajguru05/adaptivekit",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/omrajguru05/adaptivekit#readme",
  "bugs": {
    "url": "https://github.com/omrajguru05/adaptivekit/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "personalization",
    "ast",
    "codemod",
    "adaptive",
    "cli"
  ]
}
