{
  "name": "@adaptivekit/core",
  "version": "1.0.0",
  "description": "Scoring engine and ranking algorithm for AdaptiveKit. Framework-agnostic, runs anywhere.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omrajguru05/adaptivekit",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/omrajguru05/adaptivekit#readme",
  "bugs": {
    "url": "https://github.com/omrajguru05/adaptivekit/issues"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "personalization",
    "ranking",
    "ui",
    "adaptive",
    "behavioral"
  ]
}
