{
  "name": "adaptivekit",
  "version": "1.0.0",
  "private": true,
  "description": "Drop-in behavioral UI personalization for every frontend.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @adaptivekit/core",
    "build:sdk": "npm run build -w @adaptivekit/sdk",
    "build:cli": "npm run build -w @adaptivekit/cli",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omrajguru05/adaptivekit"
  }
}
